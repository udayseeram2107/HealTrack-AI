{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "shared/**/*",
    "server/src/**/*",
    "client/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "client/dist",
    "server/dist"
  ]
}
