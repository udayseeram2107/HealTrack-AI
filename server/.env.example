# ==============================================================================
# HealTrack AI - Server Environment Configuration (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Cloud Configuration
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini API
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional: Direct PostgreSQL Connection for CLI Migrations
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Google Maps Server API Key (Live Places Proxy)
GOOGLE_MAPS_SERVER_API_KEY=
