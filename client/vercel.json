{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://jmwek-2409-40f0-443a-8b0-2975-b7ad-ae27-5a40.run.pinggy-free.link/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://jmwek-2409-40f0-443a-8b0-2975-b7ad-ae27-5a40.run.pinggy-free.link/uploads/$1"
    },
    {
      "source": "/samples/(.*)",
      "destination": "https://jmwek-2409-40f0-443a-8b0-2975-b7ad-ae27-5a40.run.pinggy-free.link/samples/$1"
    },
    {
      "source": "/((?!api|uploads|samples).*)",
      "destination": "/index.html"
    }
  ]
}
