{
  "name": "healtrack-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build && node -e \"const fs = require('fs'); fs.cpSync('client/dist', 'dist', {recursive: true, force: true})\"",
    "build": "npm run build:client",
    "build:all": "npm run build:server && npm run build:client",
    "vercel-build": "npm run build:client",
    "start": "node server/dist/index.js",
    "start:server": "node server/dist/index.js",
    "db:migrate": "npm --prefix server run db:migrate"
  },
  "allowScripts": {
    "esbuild": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
